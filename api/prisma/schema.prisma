generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                 String    @id @default(uuid())
  name               String
  ownerId            String
  stripeCustomerId   String?
  subscriptionStatus String    @default("FREE")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  patients           Patient[]
  owner              User      @relation("TenantOwner", fields: [ownerId], references: [id])
  users              User[]    @relation("TenantUsers")
}

model User {
  id                String              @id @default(uuid())
  email             String?             @unique
  name              String?
  role              String              @default("CARE_GIVER")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  phoneWhats        String              @unique
  passwordHash      String?
  tenantId          String?
  medicationHistory MedicationHistory[]
  pushSubscriptions PushSubscription[]
  ownedTenants      Tenant[]            @relation("TenantOwner")
  tenant            Tenant?             @relation("TenantUsers", fields: [tenantId], references: [id])
  patients          Patient[]           @relation("PatientCaregivers")
}

model Patient {
  id                String              @id @default(uuid())
  name              String
  birthDate         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  tenantId          String?
  appointments      Appointment[]
  documents         Document[]
  medications       Medication[]
  medicationHistory MedicationHistory[]
  tenant            Tenant?             @relation(fields: [tenantId], references: [id])
  users             User[]              @relation("PatientCaregivers")
}

model Medication {
  id           String              @id @default(uuid())
  name         String
  dosage       String
  frequency    String
  startDate    DateTime
  startTime    String
  times        String[]
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  patientId    String
  instructions String
  photoUrl     String?
  patient      Patient             @relation(fields: [patientId], references: [id])
  history      MedicationHistory[]
}

model MedicationHistory {
  id           String     @id @default(uuid())
  medicationId String
  patientId    String
  userId       String
  date         String
  time         String
  takenAt      DateTime   @default(now())
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  patient      Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id])

  @@unique([medicationId, date, time])
}

model Document {
  id        String   @id @default(uuid())
  title     String
  category  String
  date      DateTime
  fileUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
}

model Appointment {
  id               String   @id @default(uuid())
  specialty        String
  doctorName       String?
  date             DateTime
  time             String
  location         String?
  notes            String?
  alertEnabled     Boolean  @default(true)
  alertHoursBefore Int      @default(24)
  intensiveAlerts  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  patientId        String
  patient          Patient  @relation(fields: [patientId], references: [id])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
