# === SUPABASE PRODUCTION (BANCO DE DADOS PRINCIPAL) ===
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# === UPLOAD DE ARQUIVOS (STORAGE SUPABASE) ===
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_SERVICE_KEY="sua-chave-service-role"

# === SEGURANÇA E AUTENTICAÇÃO ===
JWT_SECRET="seu-jwt-secret"
GOOGLE_CLIENT_ID="seu-google-client-id"

# === URL DO FRONTEND (PRODUÇÃO & CORS) ===
FRONTEND_URL="http://localhost:5173"

# === NOTIFICAÇÕES WEB PUSH (VAPID) ===
VAPID_PUBLIC_KEY="sua-vapid-public-key"
VAPID_PRIVATE_KEY="sua-vapid-private-key"
